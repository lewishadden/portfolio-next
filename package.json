{
  "name": "portfolio-next",
  "description": "Lewis Hadden online portfolio built with Next.js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://portfolio.lewishadden.com",
  "author": "Lewis Hadden <lewishadden@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:lewishadden/portfolio-next.git"
  },
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "indexnow": "node scripts/indexnow.mjs",
    "purgecss": "purgecss -c purgecss.config.cjs",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run lint:stylelint",
    "lint:fix": "eslint . --fix && npm run lint:stylelint:fix",
    "lint:stylelint": "stylelint '**/*.{scss,css}' --cache",
    "lint:stylelint:fix": "stylelint '**/*.{scss,css}' --cache --fix",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,json,css,yml,md}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx,js,json,css,scss,yml,md}\"",
    "verify": "npm run prettier:check && npm run lint && npm run typecheck",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@iconify/react": "^6.0.3",
    "@next/third-parties": "^16.4.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@vercel/functions": "^3.10.5",
    "formik": "^2.4.9",
    "framer-motion": "^14.9.0",
    "lenis": "^1.3.27",
    "maath": "^0.10.8",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.0",
    "three": "^0.186.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/utils": "^3.1.7",
    "@next/bundle-analyzer": "^16.4.3",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "globals": "^17.13.0",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "purgecss": "^8.0.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "6.0.3",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "serve": {
      "compression": "^1.8.2"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
